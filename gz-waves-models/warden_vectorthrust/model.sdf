<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='warden_vectorthrust'>
    <link name='base_link'>
      <pose relative_to='__model__'>0 0 0.0 0 0 0</pose>
      <inertial>
        <pose>0 0 -0.07 0 0 0</pose> <!-- CG 3cm from hull bottom -->
        <mass>27.73</mass> <!-- 30kg total - 2.27kg keel -->
        <inertia>
          <!-- Box inertia: 1.83m x 0.3m x 0.2m, 27.73kg -->
          <ixx>0.25</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>7.74</iyy>
          <iyz>0.0</iyz>
          <izz>7.77</izz>
        </inertia>
      </inertial>
      <!-- Tapered bow section -->
      <visual name='bow_visual'>
        <pose>0.785 0 -0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>0.83 0.25 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.5 0.4 1</ambient>
          <diffuse>0.6 0.5 0.4 1</diffuse>
        </material>
      </visual>

      <!-- Main hull body -->
      <visual name='hull_visual'>
        <pose>-0.215 0 -0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>1.4 0.3 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.5 0.4 1</ambient>
          <diffuse>0.6 0.5 0.4 1</diffuse>
        </material>
      </visual>

      <!-- Solar panel deck on top -->
      <visual name='solar_panel_visual'>
        <pose>0.085 0 0.04 0 0 0</pose>
        <geometry>
          <box>
            <size>1.44 0.68 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.3 1</ambient>
          <diffuse>0.2 0.2 0.3 1</diffuse>
        </material>
      </visual>

      <!-- Collision geometry for buoyancy -->
      <collision name='hull_collision'>
        <pose>0 0 -0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>1.83 0.3 0.15</size>
          </box>
        </geometry>
      </collision>

      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00686</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>

    <!-- Keel fin/foil connecting hull to bulb keel -->
    <link name="keel_fin">
      <pose relative_to="base_link">0 0 -0.4 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.015</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0005</iyy>
          <iyz>0.0</iyz>
          <izz>0.015</izz>
        </inertia>
      </inertial>
      <visual name='fin_visual'>
        <geometry>
          <box>
            <size>0.11 0.02 0.6</size> <!-- 110mm chord, thin foil, 600mm height -->
          </box>
        </geometry>
      </visual>
      <!-- <collision name='fin_collision'>
        <geometry>
          <box>
            <size>0.11 0.02 0.6</size>
          </box>
        </geometry>
      </collision> -->
    </link>

    <joint name="keel_fin_joint" type="fixed">
      <parent>base_link</parent>
      <child>keel_fin</child>
    </joint>

    <!-- 5 lb bulb keel at 600mm below hull bottom -->
    <link name="keel">
      <pose relative_to="keel_fin">0 0 -0.3 0 1.5708 0</pose>
      <inertial>
        <mass>2.27</mass> <!-- 5 lbs -->
        <inertia>
          <ixx>0.02</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.02</iyy>
          <iyz>0.0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name='keel_visual'>
        <geometry>
          <cylinder>
            <radius>0.03</radius> <!-- 3cm radius -->
            <length>0.2</length> <!-- 20cm long -->
          </cylinder>
        </geometry>
      </visual>
      <!-- <collision name='keel_collision'>
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.3</length>
          </cylinder>
        </geometry>
      </collision> -->
    </link>

    <joint name="keel_joint" type="fixed">
      <parent>keel_fin</parent>
      <child>keel</child>
    </joint>

    <!-- Outboard motor assembly (steering + motor pod combined) -->
    <link name="thruster_steering_link">
      <pose relative_to="base_link">-0.915 0 0 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.05</ixx>
          <iyy>0.05</iyy>
          <izz>0.01</izz>
        </inertia>
      </inertial>
      <visual name='outboard_visual'>
        <pose>0 0 -0.165 0 0 0</pose>
        <geometry>
          <box>
            <size>0.11 0.02 0.33</size>
          </box>
        </geometry>
      </visual>
      <visual name='motor_pod_visual'>
        <pose>0 0 -0.33 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.19</length>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <!-- Propeller at rear of motor assembly -->
    <link name="propeller_link">
      <pose relative_to="propeller_joint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.00036</ixx>
          <ixy>0</ixy>
          <iyy>0.00036</iyy>
          <iyz>0</iyz>
          <izz>0.00072</izz>
        </inertia>
      </inertial>
      <visual name='hub'>
        <pose>0 0 0 0 1.570796 0</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>
      <visual name='blade1'>
        <pose>0 0.06 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.12 0.005</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name='blade2'>
        <pose>0 -0.06 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.12 0.005</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <!-- <collision name="collision">
        <pose>0 0 0 0 1.570796 0</pose>
        <geometry>
          <cylinder>
            <length>0.04</length>
            <radius>0.12</radius>
          </cylinder>
        </geometry>
      </collision> -->
    </link>

    <joint name="thruster_steering_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster_steering_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.524</lower>
          <upper>0.524</upper>
        </limit>
        <dynamics>
          <damping>1.0</damping>
        </dynamics>
      </axis>
    </joint>

    <joint name="propeller_joint" type="revolute">
      <pose relative_to="thruster_steering_link">-0.15 0 -0.33 0 0 0</pose>
      <parent>thruster_steering_link</parent>
      <child>propeller_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <dynamics>
          <damping>0.001</damping>
        </dynamics>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>

    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <namespace>/model/warden_vectorthrust_0</namespace>
      <topic>servo_1</topic>
      <joint_name>propeller_joint</joint_name>
      <use_angvel_cmd>1</use_angvel_cmd>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.24</propeller_diameter>
      <thrust_coefficient>5.0</thrust_coefficient>
      <velocity_control>1</velocity_control>
      <max_thrust_cmd>104.72</max_thrust_cmd>
      <min_thrust_cmd>-104.72</min_thrust_cmd>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>thruster_steering_joint</joint_name>
      <sub_topic>servo_0</sub_topic>
      <p_gain>50</p_gain>
      <i_gain>5</i_gain>
      <d_gain>1</d_gain>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>thruster_steering_joint</joint_name>
      <joint_name>propeller_joint</joint_name>
    </plugin>
    <!-- Hydrodynamics plugin with buoyancy -->
    <plugin
        filename="gz-waves1-hydrodynamics-system"
        name="gz::sim::systems::Hydrodynamics">
        <hydrodynamics>
          <damping_on>1</damping_on>
          <viscous_drag_on>1</viscous_drag_on>
          <pressure_drag_on>1</pressure_drag_on>

          <!-- Linear and Angular Damping -->
          <!-- Linear: ~0.5*Cd*rho*A where A~0.5m² wetted, Cd~1.0 -->
          <cDampL1>50.0</cDampL1>
          <cDampL2>200.0</cDampL2>
          <!-- Angular: scaled by L² for moment arm -->
          <cDampR1>50.0</cDampR1>
          <cDampR2>50.0</cDampR2>

          <!-- 'Pressure' Drag: Cd*A for cross-flow -->
          <!-- Lateral drag much higher than streamwise -->
          <cPDrag1>20.0</cPDrag1>
          <cPDrag2>200.0</cPDrag2>
          <fPDrag>0.4</fPDrag>
          <cSDrag1>20.0</cSDrag1>
          <cSDrag2>200.0</cSDrag2>
          <fSDrag>0.4</fSDrag>
          <vRDrag>1.0</vRDrag>
        </hydrodynamics>
    </plugin>
  </model>
</sdf>
